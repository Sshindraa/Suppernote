# Suppernote — Variables d'environnement locales

DATABASE_URL="postgresql://sokar:password@localhost:5432/sokar_dev"
REDIS_URL="redis://localhost:6379"

# ─── App ───────────────────────────────────────────────────────────────────
PUBLIC_URL="http://localhost:4000"
OAUTH_ISSUER_URL="http://localhost:4000"
# SITE_URL : domaine canonique du site public Suppernote Connect (suppernote.com).
# Utilisé par apps/connect (buildPublicRestaurantJsonLd dans @suppernote/shared) pour les URLs @id/url du JSON-LD.
# En prod : https://suppernote.com
SITE_URL="http://localhost:4002"
PUBLIC_API_URL="http://localhost:4000"
# Adresse PUBLIQUE du dashboard : elle sert aux retours Stripe (paiement, portail), aux e-mails (essai,
# relances), aux liens « gérer ma réservation », aux invitations. En production : https://suppernote.com
# (le dashboard y est servi sous /dashboard). `app.suppernote.com` n'est servi par rien :
# un lien vers cet hôte aboutit à une page 404.
DASHBOARD_URL="http://localhost:3000"
API_URL="http://127.0.0.1:4000"
NODE_ENV="development"
# Active les routes /api/test (simulation d'appel). En prod, doit être false (SEC-005).
ENABLE_TEST_ROUTES="true"
# Protection /metrics (SEC-006). Défaut : allowlist loopback. Auth basique prioritaire si user+password définis.
# METRICS_BASIC_AUTH_USER="prometheus"
# METRICS_BASIC_AUTH_PASSWORD="REPLACE"
# METRICS_ALLOWLIST_IPS="127.0.0.1, ::1"
# Active l'auth dev MCP (SEC-007). NE JAMAIS mettre true en production.
ENABLE_DEV_AUTH="true"
# AGENT_DEV_KEY="sk_suppernote_agent_..."
# HMAC partagé pour le feed OpenAI Reserve (RES-007). Si défini, /v1/businesses
# exige un ?signature=... valide. Générer une clé ≥ 32 chars et la partager avec OpenAI.
# OPENAI_RESERVE_HMAC_KEY="REPLACE-WITH-32-CHAR-SECRET"
LOG_LEVEL="info"
TZ="Europe/Paris"
SENTRY_DSN=""

# ─── Auth ──────────────────────────────────────────────────────────────────
CLERK_PUBLISHABLE_KEY="pk_..."
CLERK_SECRET_KEY="sk_..."
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_..."
# IDs Clerk des opérateurs Suppernote (CSV), jamais les utilisateurs des restaurants.
SOKAR_OPERATOR_USER_IDS="user_..."
RESERVATION_SERVICE_TOKEN=

# ─── Telnyx / Voice ────────────────────────────────────────────────────────
TELNYX_API_KEY="KEY..."
# EU (Frankfurt) : TELNYX_API_URL="https://api.telnyx.eu" + TELNYX_API_BASE="api.telnyx.eu"
# US (défaut)    : laisser vide ou commenter
# TELNYX_API_URL="https://api.telnyx.eu"
# TELNYX_API_BASE="api.telnyx.eu"

# Enregistrement temporaire des appels de test (désactivé par défaut).
# Même activé, seuls les restaurants explicitement listés peuvent être enregistrés.
CALL_RECORDING_ENABLED="false"
CALL_RECORDING_TEST_RESTAURANT_IDS=""
CALL_RECORDINGS_BUCKET="sokar-call-recordings"
CALL_RECORDINGS_REGION="eu-west-3"
# Endpoint optionnel pour R2/MinIO ; laisser vide pour AWS S3.
# CALL_RECORDINGS_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
# CALL_RECORDINGS_ACCESS_KEY_ID="..."
# CALL_RECORDINGS_SECRET_ACCESS_KEY="..."
CALL_RECORDINGS_RETENTION_DAYS="30"
CALL_RECORDINGS_MAX_BYTES="50000000"
# Rapport automatique de chaque appel enregistré (docs/runbooks/call-reports.md), toujours actif.
# Il se construit à partir de l'enregistrement et demande DEEPGRAM_API_KEY ; ~1 centime par appel de transcriptions Deepgram.
# Plafond du nombre de rapports générés (coût Deepgram) ; absent = illimité. Compteur : clé Redis call-report:generated.
# CALL_REPORT_MAX_REPORTS="100"
# CALL_REPORT_LOG_DIR="/var/log/sokar"
TELNYX_PUBLIC_KEY="..."
TELNYX_APP_ID="..."
# Application voix Telnyx à laquelle l'attribution relie chaque numéro (admin Provisioning).
TELNYX_CONNECTION_ID="..."
TELNYX_WEBHOOK_SECRET="..."
# Genre de la voix de l'agent (masculine | feminine), quel que soit le fournisseur de synthèse : le prompt en
# tient compte pour accorder (voir environment.md). À changer avec la voix.
VOICE_GENDER=""

TELNYX_FROM_NUMBER="+33XXXXXXXXX"
# Expéditeur des SMS si différent du numéro d'appel : numéro rattaché au profil de messagerie,
# ou identifiant alphanumérique (ex. SUPPERNOTE, sans réponse possible).
# TELNYX_SMS_FROM="SUPPERNOTE"
# Profil Messaging Telnyx auquel le numéro expéditeur est affecté.
# TELNYX_MESSAGING_PROFILE_ID="uuid"
# Numéro WhatsApp Business validé sur ce profil (requis si le marketing WhatsApp est activé).
# TELNYX_WHATSAPP_FROM="+33XXXXXXXXX"

# ─── WhatsApp Business via Telnyx BSP (optionnel) ──────────────────────────
# Telnyx est BSP WhatsApp officiel — embedded signup gère le Meta Business
# Manager de bout en bout. Même API key Telnyx que pour SMS/voice.
#
# Setup : Mission Control → Messaging → WhatsApp → Get Started (15 min)
# Puis créer le template "reservation_reminder" (UTILITY, fr) et attendre
# l'approbation Meta (24-48h).
#
# Si WHATSAPP_ENABLED=true et TELNYX_WHATSAPP_FROM est renseigné, les rappels
# J-1 utilisent WhatsApp uniquement pour WEB avec consents.transactionalWhatsapp=true.
# Sans accord/configuration ou en cas d'echec : aucun rappel SMS de secours.
# La réactivation VIP reste toujours sur SMS (marketing WhatsApp coûte 5x plus).
# MARKETING_SENDS_ENABLED="false"
# MARKETING_WHATSAPP_ENABLED="false"
# Pilote : liste blanche de contacts de test (e-mails ou numéros séparés par des virgules).
# Renseignée, seuls ces contacts reçoivent un message marketing ; vide, aucune restriction.
# MARKETING_RECIPIENT_ALLOWLIST=""
# Registre d'opposition (clé HMAC, >= 32 caracteres, a sauvegarder) : sans elle, aucun envoi marketing.
# MARKETING_OPTOUT_HASH_SECRET=""
#
WHATSAPP_ENABLED="false"
# Collecte du choix sur Connect, independante de l'activation des envois.
WHATSAPP_CONSENT_ENABLED="false"
# Page privee Ma reservation ; aucune activation ou cle implicite.
RESERVATION_MANAGEMENT_ENABLED="false"
# Cle aleatoire 32 octets en hex, key_env uniquement, distincte des autres secrets.
# RESERVATION_MANAGEMENT_SECRET=""
# telnyx (par defaut) ou meta ; aucun changement de fournisseur implicite.
WHATSAPP_PROVIDER="telnyx"
# Meta direct : secrets charges uniquement depuis l'environnement.
# META_WHATSAPP_ACCESS_TOKEN=""
# META_WHATSAPP_PHONE_NUMBER_ID=""
# Version Graph a qualifier explicitement avant activation (ex. v25.0).
# META_WHATSAPP_GRAPH_VERSION=""
META_WHATSAPP_WEBHOOK_ENABLED="false"
# META_WHATSAPP_APP_SECRET=""
# META_WHATSAPP_VERIFY_TOKEN=""
# META_WHATSAPP_WABA_ID=""

# ─── LLM vocal : Cerebras (fournisseur unique) ────────────────────────────
# Une panne bascule le tour structuré sur le secours OpenRouter, puis sur une
# réponse parlée déterministe.
VOICE_LLM_PROVIDER="cerebras"
VOICE_LLM_MODEL="qwen-3.8-27b"
VOICE_LLM_TIMEOUT_MS="8000"
CEREBRAS_API_KEY=""
CEREBRAS_BASE_URL="https://api.cerebras.ai/v1"

# Span-01 : mesure shadow asynchrone, sans effet sur les réponses vocales.
VOICE_SEMANTIC_SIGNALS_SAMPLE_RATE="1"
# openrouter (défaut, /alpha/decisions, modèle Jev figé) ou respan (/scores).
VOICE_SEMANTIC_SIGNALS_PROVIDER="openrouter"
# Modèle : typesafe/jev-1.13-20260917 pour openrouter, span-01-pro ou span-01-free pour respan.
VOICE_SEMANTIC_SIGNALS_MODEL=""
VOICE_SEMANTIC_SIGNALS_TIMEOUT_MS="2000"
VOICE_SEMANTIC_SIGNALS_HISTORY_TURNS="3"
VOICE_SEMANTIC_AUTO_EVAL_ENABLED="false"
VOICE_SEMANTIC_AUTO_EVAL_MAX_TURNS="300"
VOICE_SEMANTIC_JUDGE_MODEL="xiaomi/mimo-v2.6-pro"
RESPAN_BASE_URL="https://api.respan.ai/api/v1"
# RESPAN_API_KEY=""  # Secret à injecter par environnement, jamais dans le dépôt.

# Clé OpenRouter : secours du tour structuré si Cerebras échoue (JSON Schema
# strict, VOICE_STRUCTURED_FALLBACK_MODEL) et écoute des appels par modèle audio
# (scripts/ops/voice_call_audio.py --listen). Valeur non quotée à dessein : le
# scanner de secrets du pre-commit la lit comme une vraie clé sinon.
OPENROUTER_API_KEY=sk-or-...
# Adresse du secours vocal seul (vide = OPENROUTER_BASE_URL). Routage UE : https://eu.openrouter.ai/api/v1
# OPENROUTER_FALLBACK_BASE_URL=

# ─── Reconnaissance vocale : Deepgram (production) ─────────────────────────
# Obligatoire en production. Aucun secours : si Deepgram ne s'ouvre pas, l'appel suit le chemin
# « reconnaissance indisponible ».
DEEPGRAM_API_KEY="..."

# ─── Cartesia TTS ──────────────────────────────────────────────────────────
CARTESIA_API_KEY="..."
CARTESIA_VOICE_ID="90358bc7-3328-4b93-a942-d0447d7d4b5c"
# ID optionnel d'un dictionnaire de prononciation Cartesia partagé.
# La personnalité d'un restaurant peut surcharger ce dictionnaire.
# CARTESIA_PRONUNCIATION_DICT_ID="dict_..."

# ─── Email ─────────────────────────────────────────────────────────────────
# Resend HTTP API (port 443, bypass SMTP block in Frankfurt).
# L'ancienne config SMTP_* est dépréciée.
RESEND_API_KEY="re_..."
EMAIL_FROM="Suppernote <noreply@suppernote.com>"
# Adresse de réponse (défaut : hello@suppernote.com)
# EMAIL_REPLY_TO="hello@suppernote.com"
# Rapports nocturnes aux gestionnaires. Désactiver en staging sans fournisseur isolé.
EVENING_REPORTS_ENABLED="true"
# Secret Svix du webhook Resend (email.sent/delivered/bounced/complained).
# Laisser vide tant que les campagnes marketing ne sont pas activées.
RESEND_WEBHOOK_SECRET=""

# Feed opérateur des callbacks marketing non reconnus (jamais exposé au dashboard).
# SOKAR_INTERNAL_MARKETING_TOKEN=""

# ─── Alertes ops (monitoring pilote) ────────────────────────────────────────
# Canaux de réception des alertes du worker system-health (toutes les 5 min :
# files BullMQ, jobs failed/dead-letter, webhooks Telnyx en erreur, appels sans
# transcription, réservations sans SMS). Tous optionnels ; sans aucun canal,
# les alertes ne partent que dans les logs + Sentry.
#   Destinataires email des alertes (séparés par des virgules) :
# ALERT_EMAIL_TO="ops@suppernote.com"
#   Webhook Slack/Discord (payload { "text": "..." }) :
# ALERT_WEBHOOK_URL="https://hooks.slack.com/services/..."
#   Numéro E.164 recevant un SMS pour les alertes CRITIQUES uniquement :
# ALERT_SMS_TO="+33612345678"

# ─── Demandes de démonstration (vitrine /demo) ──────────────────────────────
# Destinataires e-mail des nouvelles demandes (séparés par des virgules). Sans valeur,
# la demande est enregistrée mais aucun e-mail n'est envoyé : elle apparaît dans le suivi
# opérateur avec la mention « Notification non envoyée ». Utilise RESEND_API_KEY et EMAIL_FROM.
# DEMO_REQUEST_NOTIFY_TO="ventes@example.com"
# Note : le watchdog VPS (scripts/ops/sokar-watchdog.sh) a sa propre config
# dans /etc/sokar/watchdog.env (ALERT_WEBHOOK / ALERT_CMD / HEALTHCHECKS_PING_URL).
# Seuils de suivi interne 70/90/100 % : optionnels, sans impact sur la promesse
# client sans quota. La vue /dashboard/admin/margin reste la source visuelle.
USAGE_ALERTS_ENABLED="false"
# Budgets facultatifs par établissement pour le cost-watch interne uniquement.
# USAGE_ALERT_VOICE_BUDGET_MINUTES="1000"
# USAGE_ALERT_SMS_BUDGET_SEGMENTS="500"
# Rôles autorisés à lire les notes CRM sensibles (CSV, moindre privilège par défaut).
# Un Owner peut surcharger cette liste pour un site via PATCH /crm/privacy.
CRM_SENSITIVE_NOTE_ROLES="OWNER,MANAGER"
# POS connectors: keep disabled until a provider sandbox and pilot are qualified.
POS_CONNECTORS_ENABLED="false"
RESERVATION_PAYMENTS_ENABLED="false"
CUSTOMER_GROUPS_ENABLED="false"
EXPERIENCES_ENABLED="false"
EVENTS_ENABLED="false"
DISTRIBUTION_ENABLED="false"

# ─── Stripe (cartes cadeaux + abonnements) ─────────────────────────────────
STRIPE_SECRET_KEY="..."
STRIPE_PUBLISHABLE_KEY="..."
# Secret de signature du webhook : Stripe Dashboard → Développeurs → Webhooks → endpoint secret.
STRIPE_WEBHOOK_SECRET="..."
# Prix récurrents créés dans Stripe (un prix mensuel et annuel par formule).
# Le checkout refuse proprement la souscription tant que les huit valeurs ne sont pas renseignées.
STRIPE_PRICE_ESSENTIAL_MONTHLY="price_..."
STRIPE_PRICE_ESSENTIAL_ANNUAL="price_..."
STRIPE_PRICE_PRO_MONTHLY="price_..."
STRIPE_PRICE_PRO_ANNUAL="price_..."
STRIPE_PRICE_MULTI_SITE_MONTHLY="price_..."
STRIPE_PRICE_MULTI_SITE_ANNUAL="price_..."
STRIPE_PRICE_MULTI_SITE_ADDON_MONTHLY="price_..."
STRIPE_PRICE_MULTI_SITE_ADDON_ANNUAL="price_..."

# ─── Google Places (Connect + onboarding) ──────────────────────────────────
# Clé serveur pour Places API (New), utilisée par les fiches Connect et la recherche
# facultative d'établissement au début de l'onboarding. Restreindre par API et IP serveur.
# Afficher l'attribution Google Maps et vérifier les règles de conservation avant production.
# GOOGLE_PLACES_API_KEY=""
# Activation séparée de la recherche Places dans l'onboarding (off par défaut).
GOOGLE_PLACES_ONBOARDING_ENABLED="false"

# ─── Captcha Cloudflare Turnstile (SEC-009) ───────────────────────────────
# Si défini, /api/rgpd/request-verification exige un token Turnstile côté client.
# TURNSTILE_SECRET_KEY=""

# ─── Feature flags ─────────────────────────────────────────────────────────
VIP_PUSH_ENABLED="false"

# ─── AWS / LocalStack ──────────────────────────────────────────────────────
AWS_REGION="eu-west-1"
# USE_LOCALSTACK="true"
# LOCALSTACK_AUTH_TOKEN="ls-..."

# ─── ConfigCat Feature Flags ─────────────────────────────────────────────
# CONFIGCAT_SDK_KEY="..."

# ─── Sentry (error tracking) ───────────────────────────────────────────
# API + Dashboard server/edge
# SENTRY_DSN="https://..."
# SENTRY_RELEASE="1.0.0"
# SENTRY_TRACES_SAMPLE_RATE="0.1"
# SENTRY_SAMPLE_RATE="1.0"

# Dashboard client only
# NEXT_PUBLIC_SENTRY_DSN="https://..."
# NEXT_PUBLIC_SENTRY_RELEASE="1.0.0"
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.1"
# NEXT_PUBLIC_SENTRY_SAMPLE_RATE="1.0"
# NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE="0"

# ─── Cloudflare for SaaS (P2 premium subdomain) ──────────────
# Optionnel — si non configuré, le customDomain est stocké en DB sans provisioning CF.
# CLOUDFLARE_API_TOKEN=""        # Token avec permissions Zone.SaaS + Zone.DNS
# CLOUDFLARE_ZONE_ID=""          # Zone ID de suppernote.com (dashboard Cloudflare > Overview)
# CLOUDFLARE_SAAS_FALLBACK_ORIGIN="suppernote.com"  # Origin qui reçoit le trafic des custom domains

# Personal reservation links: keep disabled until routing and delivery qualification.
RESERVATION_MANAGEMENT_ENABLED="false"
# RESERVATION_MANAGEMENT_SECRET="" # key_env: 32 random bytes, hex encoded
# Dedicated SMS sender, separate from TELNYX_FROM_NUMBER used for voice.
# TELNYX_SMS_FROM=""
# Optional per-message delivery webhook; disables profile fallback when set.
# TELNYX_SMS_WEBHOOK_URL=""

# Secret de signature des liens de retour privé (au moins 32 caractères ; key_env).
REPUTATION_EMAIL_SECRET=""
