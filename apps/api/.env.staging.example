# Suppernote — Variables d'environnement STAGING
#
# Copie ce fichier en .env sur le VPS staging (/opt/suppernote-staging/apps/api/.env).
# JAMAIS de clés de prod. Voice désactivée. Stripe en mode test.
#
# DB : sokar_staging (séparée de sokar_dev / sokar_prod).
# Redis : db=3 (prod utilise db=0/1/2 pour session/cache/queue).
#
# Prisma/PostgreSQL timeouts — recommandé : ajouter ?statement_timeout=10000
# à DATABASE_URL pour qu'PostgreSQL tue les requêtes qui dépassent 10s au
# niveau serveur (garde-fou en plus des transactionOptions Prisma).
# Ex: DATABASE_URL="postgresql://user:pass@host:5432/db?statement_timeout=10000&connect_timeout=10"

DATABASE_URL="postgresql://sokar:CHANGE_ME_PASSWORD@localhost:5432/sokar_staging"
REDIS_URL="redis://localhost:6379/3"

# ─── App ───────────────────────────────────────────────────────────────────
PUBLIC_URL="https://api-staging.suppernote.com"
OAUTH_ISSUER_URL="https://api-staging.suppernote.com"
SITE_URL="https://staging.suppernote.com"
PUBLIC_API_URL="https://api-staging.suppernote.com"
DASHBOARD_URL="https://staging.suppernote.com"
API_URL="https://api-staging.suppernote.com"
NODE_ENV="production"
# Routes /api/test desactivées explicitement en staging/production (SEC-005).
ENABLE_TEST_ROUTES="false"
# Protection /metrics (SEC-006). Allowlist loopback si Prometheus scrape via Nginx local.
# Pour auth basique, définir METRICS_BASIC_AUTH_USER + METRICS_BASIC_AUTH_PASSWORD.
METRICS_ALLOWLIST_IPS="127.0.0.1, ::1"
# Auth dev MCP strictement désactivée en staging/production (SEC-007).
ENABLE_DEV_AUTH="false"
# HMAC partagé pour le feed OpenAI Reserve (RES-007). Décommenter + renseigner
# pour exiger un ?signature=... valide sur /v1/businesses.
# OPENAI_RESERVE_HMAC_KEY=""
LOG_LEVEL="debug"
TZ="Europe/Paris"
SENTRY_DSN=""

# CORS — allowlist explicite des origins navigateur (comma-separated).
# En production, CORS_ORIGINS est OBLIGATOIRE (fail-fast au démarrage si absent).
CORS_ORIGINS="https://staging.suppernote.com,https://www.staging.suppernote.com"

# Reverse proxy IPs (Nginx, Cloudflare). Comma-separated.
# Local Nginx on the same VPS uses 127.0.0.1. Add the VPS public IP if needed.
TRUSTED_PROXY_IPS="127.0.0.1, ::1, 57.131.148.179"

# ─── Auth (Clerk STAGING — pk_test / sk_test) ──────────────────────────────
CLERK_PUBLISHABLE_KEY="pk_test_REPLACE_ME"
CLERK_SECRET_KEY="sk_test_REPLACE_ME"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_REPLACE_ME"
# IDs Clerk autorisés pour les opérations Suppernote multi-restaurant.
SOKAR_OPERATOR_USER_IDS="user_REPLACE_ME"
RESERVATION_SERVICE_TOKEN=

# ─── Voice : DÉSACTIVÉE en staging ─────────────────────────────────────────
# VOICE_DISABLED=true indique à env.ts de ne pas valider les clés voice.
# L'API n'initialise pas le client Telnyx sans TELNYX_API_KEY. Les webhooks
# entrants échouent la vérification de signature (403). Deepgram/Cartesia
# ne sont pas appelés non plus. NE PAS renseigner de clés prod ici.
VOICE_DISABLED="true"
TELNYX_API_KEY=""
TELNYX_PUBLIC_KEY=""
TELNYX_APP_ID=""
TELNYX_CONNECTION_ID=""
TELNYX_WEBHOOK_SECRET=""
TELNYX_FROM_NUMBER=""
# TELNYX_MESSAGING_PROFILE_ID=""
TELNYX_WHATSAPP_FROM=""

# ─── LLM (Cerebras + secours OpenRouter, optionnel en staging) ─────────────
CEREBRAS_API_KEY=""
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# ─── Reconnaissance vocale Deepgram (désactivée en staging) ────────────────
DEEPGRAM_API_KEY=""

# ─── Cartesia TTS (désactivé en staging) ───────────────────────────────────
CARTESIA_API_KEY=""
CARTESIA_VOICE_ID="90358bc7-3328-4b93-a942-d0447d7d4b5c"

# ─── Email (désactivé — pas de Resend en staging) ──────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="noreply@suppernote.com"
EVENING_REPORTS_ENABLED="false"
# Secret Svix du webhook Resend ; requis uniquement pour un pilote d'envoi.
RESEND_WEBHOOK_SECRET=""
# Jeton opérateur pour lister/réconcilier les callbacks marketing non reconnus.
# SOKAR_INTERNAL_MARKETING_TOKEN=""
MARKETING_SENDS_ENABLED="false"
MARKETING_WHATSAPP_ENABLED="false"
# Quotas commerciaux encore non validés : aucune alerte de consommation active.
# Seuils de suivi interne uniquement (aucun quota ni blocage client).
USAGE_ALERTS_ENABLED="false"
# Budgets facultatifs de cost-watch opérateur ; laisser absents pour un simple suivi visuel.
# USAGE_ALERT_VOICE_BUDGET_MINUTES="1000"
# USAGE_ALERT_SMS_BUDGET_SEGMENTS="500"
# Rôles autorisés à lire les notes CRM sensibles (CSV, moindre privilège par défaut).
# Un Owner peut surcharger cette liste pour un site via PATCH /crm/privacy.
CRM_SENSITIVE_NOTE_ROLES="OWNER,MANAGER"
# POS connectors: keep disabled until a provider sandbox and pilot are qualified.
POS_CONNECTORS_ENABLED="false"
RESERVATION_PAYMENTS_ENABLED="false"
CUSTOMER_GROUPS_ENABLED="false"
EXPERIENCES_ENABLED="false"
EVENTS_ENABLED="false"
DISTRIBUTION_ENABLED="false"

# ─── Captcha Cloudflare Turnstile (SEC-009) ───────────────────────────────
# Si défini, /api/rgpd/request-verification exige un token Turnstile côté client.
# TURNSTILE_SECRET_KEY=""

# ─── Stripe (mode TEST) ────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_REPLACE_ME"
STRIPE_PUBLISHABLE_KEY="pk_test_REPLACE_ME"
# Secret de signature du webhook : Stripe Dashboard → Développeurs → Webhooks → endpoint secret.
STRIPE_WEBHOOK_SECRET=""

# ─── Feature flags ─────────────────────────────────────────────────────────
VIP_PUSH_ENABLED="false"

# ─── Cloudflare for SaaS (P2 premium subdomain) ──────────────────────────────
# OPTIONNEL en staging — le guard isCloudflareSaaSEnabled() gère l'absence des vars.
# Si non configuré, le customDomain est stocké en DB sans provisioning Cloudflare.
# En staging, on laisse généralement ces vars vides (le custom domain se teste en prod).
# CLOUDFLARE_API_TOKEN=""        # Token avec permissions Zone.SaaS + Zone.DNS
# CLOUDFLARE_ZONE_ID=""          # Zone ID de suppernote.com (dashboard Cloudflare > Overview)
# CLOUDFLARE_SAAS_FALLBACK_ORIGIN="suppernote.com"  # Origin qui reçoit le trafic des custom domains

# Secret de signature des liens de retour privé (au moins 32 caractères ; key_env).
REPUTATION_EMAIL_SECRET=""
