# apps/connect/.env.example
# Copie ce fichier en .env (jamais commité) avec les vraies valeurs.
# En prod : /opt/suppernote/apps/connect/.env (sourcé par bin/run-connect.sh).
#
# Site public — utilisé pour canonical, OpenGraph, JSON-LD
SITE_URL=https://suppernote.com

# Dashboard (apps/dashboard) — utilisé pour autoriser l'iframe preview
# (?preview=1) dans le middleware Suppernote Connect.
# En local : http://localhost:3000
# En prod : https://suppernote.com (même domaine, 'self' suffit)
DASHBOARD_URL=http://localhost:3000

# API Fastify (apps/api) — utilisée pour les fetches SSR (availability, hold, confirm)
# En local : http://localhost:3001
# En prod : http://127.0.0.1:4000 (interne, pas public)
API_URL=http://localhost:3001
# Adresse publique de l'API, publiée aux assistants IA (llms.txt, ai-plugin). Jamais l'adresse interne.
PUBLIC_API_URL=https://api.suppernote.com

# Port d'écoute du serveur Next standalone
PORT=4002
HOSTNAME=0.0.0.0

# API Fastify (apps/api) — utilisée pour les fetches SSR ET client (cartes cadeaux)
# NEXT_PUBLIC_API_URL est exposée au bundle client (préfixe NEXT_PUBLIC_)
# En local : http://localhost:3001
# En prod : https://suppernote.com (le client passe par Nginx qui route /api/* vers l'API)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Telemetry Next.js — désactivée par défaut
NEXT_TELEMETRY_DISABLED=1

# ─── Sentry (optionnel, erreurs serveur uniquement) ──────────────────────
# En déploiement, écrit par `scripts/ops/sync-env.sh sentry-connect` (secret GitHub
# SENTRY_DSN_CONNECT). Pas de NEXT_PUBLIC_SENTRY_DSN : le navigateur n'est pas instrumenté.
# SENTRY_DSN=https://...
# SENTRY_ENVIRONMENT=staging
# SENTRY_RELEASE=1.0.0
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_SAMPLE_RATE=1.0

# ─── Stripe (cartes cadeaux P2) ─────────────────────────────────────────
# Clé publique Stripe (exposée au client, préfixe NEXT_PUBLIC_)
# En dev : pk_test_*
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test

# ─── Google Search Console (vérification de propriété) ──────────────────
# Token fourni par GSC (méthode meta tag). Baké au build (préfixe NEXT_PUBLIC_).
# Alternative : déposer le fichier google<hash>.html dans apps/connect/public/.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
