SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Watchdog Suppernote : toutes les 5 minutes.
# API/dashboard/connect, Redis, Postgres, backup quotidien, disque, mémoire.
# Config des canaux d'alerte : /etc/suppernote/watchdog.env
*/5 * * * * root /usr/local/sbin/suppernote-watchdog >> /var/log/suppernote/watchdog.log 2>&1
