{
  "name": "suppernote",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint && pnpm lint:css",
    "lint:css": "stylelint --config packages/config/.stylelintrc.json \"apps/*/src/**/*.css\"",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "pnpm --filter @suppernote/dashboard test:e2e",
    "test:visual": "pnpm --filter @suppernote/dashboard test:visual",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "prepare": "husky",
    "db:generate": "cd packages/database && prisma generate --no-hints",
    "db:push": "node scripts/quality/check-db-push-target.mjs && cd packages/database && prisma db push",
    "db:studio": "cd packages/database && prisma studio",
    "db:seed": "pnpm --filter @suppernote/database seed",
    "infra:up": "docker compose --env-file .env.local -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "test:diagnostic": "node --env-file=.env.local tools/diagnostics/test-stt-tts.mjs",
    "test:mcp:client": "pnpm --filter @suppernote/api exec tsx ../../tools/diagnostics/test-mcp-client.ts",
    "test:mcp:stdio": "pnpm --filter @suppernote/api exec tsx ../../tools/diagnostics/sokar-mcp-stdio.ts",
    "tunnel:status": "cloudflared tunnel info sokar",
    "tunnel:logs": "tail -n 50 -f ~/Library/Logs/com.cloudflare.cloudflared.err.log",
    "redis:start": "brew services start redis",
    "redis:stop": "brew services stop redis",
    "redis:status": "brew services list | grep redis",
    "node:check": "node -e \"const v=process.versions.node.split('.').map(Number); if (v[0]<20 || (v[0]===20 && v[1]<9) || v[0]>=23) { console.error('Node '+process.versions.node+' not supported. Use Node >=20.9 <23.'); process.exit(1); } console.log('Node '+process.versions.node+' OK');\"",
    "verify:precommit": "scripts/precommit-review.sh",
    "verify:prepush": "scripts/prepush-quality-gate.sh",
    "verify:product-gates": "node scripts/verify-product-gates.mjs",
    "verify:ai": "scripts/agent/hermes-diff-review.sh head",
    "pr:submit": "scripts/agent/submit-pr.sh",
    "dogfood:sokar": "tools/diagnostics/dogfood-sokar.sh",
    "deploy:prod": "gh workflow run deploy-prod.yml --ref main",
    "deploy:staging": "gh workflow run deploy-staging.yml --ref main"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@types/node": "^20.19.43",
    "husky": "^9.1.7",
    "prettier": "^3.5.0",
    "prisma": "^6.0.0",
    "stylelint": "^16.26.1",
    "turbo": "^2.11.9",
    "typescript": "^5.8.0",
    "zod": "^4.6.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp"
    ],
    "overrides": {
      "@hono/node-server": ">=2.1.3",
      "@opentelemetry/core": ">=2.8.0",
      "brace-expansion": ">=5.0.11",
      "browserslist": ">=4.28.7",
      "deepmerge-ts": ">=8.0.0",
      "esbuild": ">=0.28.1",
      "fast-copy": ">=4.1.0",
      "find-my-way": ">=9.7.0",
      "glob": ">=14.0.2",
      "hono": ">=4.13.7",
      "fast-uri": ">=4.2.3 <5.0.0",
      "ip-address": ">=10.7.1",
      "js-cookie": ">=3.0.7",
      "js-yaml": ">=5.4.1",
      "minimatch": ">=11.0.1",
      "nanoid": ">=3.3.18",
      "postcss": ">=8.5.18",
      "proxy-addr": ">=2.0.8",
      "qs": ">=6.16.0",
      "sharp": ">=0.35.5",
      "source-map-js": ">=1.2.2",
      "undici": ">=7.29.1 <8.0.0",
      "uuid": ">=11.1.1",
      "vite": "8.1.6",
      "minimatch@3>brace-expansion": "^1.1.21",
      "postcss-selector-parser@<6.1.5": "^6.1.5",
      "body-parser": ">=2.4.0 <3"
    }
  },
  "engines": {
    "node": ">=20.9.0 <23.0.0"
  },
  "packageManager": "pnpm@10.33.3"
}
