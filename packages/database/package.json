{
  "name": "@suppernote/database",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "build": "prisma generate && tsc",
    "generate": "prisma generate",
    "push": "node ../../scripts/quality/check-db-push-target.mjs && prisma db push",
    "seed": "prisma db seed",
    "seed:companion": "tsx --env-file=../../apps/api/.env prisma/seed-companion.ts",
    "seed:demo-service": "tsx --env-file=../../apps/api/.env prisma/seed-demo-service.ts",
    "backfill:restaurant-accounts": "tsx prisma/scripts/backfill-restaurant-accounts.ts",
    "seed:floor-plan": "tsx scripts/migrate-floor-plan.ts",
    "mcp:sandbox": "tsx prisma/scripts/mcp-sandbox.ts",
    "unpublish:demo-restaurants": "tsx scripts/unpublish-demo-restaurants.ts",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "studio": "prisma studio",
    "lint": "tsc --noEmit",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "tsx --test prisma/scripts/mcp-sandbox.test.ts",
    "clean": "rm -rf .turbo dist"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@suppernote/config": "workspace:*"
  },
  "devDependencies": {
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
